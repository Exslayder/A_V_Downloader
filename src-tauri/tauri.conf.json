{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AVDock",
  "version": "0.1.0",
  "identifier": "com.exslayder.avdock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AVDock",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/ffmpeg.exe"],
    "createUpdaterArtifacts": true,
    "shortDescription": "Downloader and converter for YouTube and SoundCloud",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Exslayder/AVDock/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5OTNGRjEwQ0EzMTI3QUIKUldTckp6SEtFUCtUdWVqcHlIM1RrbHhKSXlVd2ZVSGNRY3J5QUFnV0YwMnBPNldHc3VXSlNGMW4K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
